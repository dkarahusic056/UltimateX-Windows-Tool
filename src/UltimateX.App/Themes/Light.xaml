<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light Theme (v1.1): helles Graphit, gleiche rote Akzentlogik wie Dark -->
    <Color x:Key="Color.Accent">#C00000</Color>
    <Color x:Key="Color.AccentHot">#E01010</Color>
    <Color x:Key="Color.AccentDeep">#7A0000</Color>
    <Color x:Key="Color.Glow">#E01010</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="#EDEDED" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#E2E2E2" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FAFAFA" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#F1F1F1" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#F6DCDC" />
    <SolidColorBrush x:Key="Brush.Border" Color="#D2D2D2" />
    <SolidColorBrush x:Key="Brush.Text" Color="#141414" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#5C5C5C" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="#8C8C8C" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#C00000" />
    <SolidColorBrush x:Key="Brush.AccentHot" Color="#E01010" />
    <SolidColorBrush x:Key="Brush.AccentDeep" Color="#7A0000" />
    <SolidColorBrush x:Key="Brush.Accent2" Color="#E01010" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#1AC00000" />
    <SolidColorBrush x:Key="Brush.Ok" Color="#138A4E" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#B86E00" />
    <SolidColorBrush x:Key="Brush.Problem" Color="#D01010" />
    <SolidColorBrush x:Key="Brush.Na" Color="#9A9A9A" />
    <SolidColorBrush x:Key="Brush.ChartFill" Color="#26C00000" />
    <SolidColorBrush x:Key="Brush.Series1" Color="#C00000" />
    <SolidColorBrush x:Key="Brush.Series2" Color="#3A3A3A" />
    <SolidColorBrush x:Key="Brush.Series3" Color="#7A0000" />
    <SolidColorBrush x:Key="Brush.Grid" Color="#E0E0E0" />
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#D2D2D2" />
    <LinearGradientBrush x:Key="Brush.Hero" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F7E6E6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.NavSelected" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#33C00000" Offset="0" />
        <GradientStop Color="#00C00000" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.PrimaryFill" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D40000" Offset="0" />
        <GradientStop Color="#9A0000" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
