<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:UltimateX.App.ViewModels"
                    xmlns:ctl="clr-namespace:UltimateX.App.Controls">

    <!-- ===================== Gaming / Performance Mode (§6) ===================== -->
    <DataTemplate x:Key="GamingTileTemplate" DataType="{x:Type vm:GamingTile}">
        <ctl:ChamferBorder Style="{StaticResource Card}" Width="270" Height="150" Background="{DynamicResource Brush.Hero}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.CardHeader}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Value}" FontSize="26" FontWeight="Bold" Margin="0,14,0,4"
                               Foreground="{Binding State, Converter={StaticResource StateBrush}}" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.MutedWrap}" FontSize="11" MaxHeight="32" />
                </StackPanel>
                <Grid Grid.Column="1" Width="70" Height="70" VerticalAlignment="Center"
                      Visibility="{Binding Percent, Converter={StaticResource NullToVis}}">
                    <ctl:Ring Value="{Binding Percent}" Thickness="7" TrackBrush="{DynamicResource Brush.Border}" RingBrush="{DynamicResource Brush.Accent}" />
                </Grid>
            </Grid>
        </ctl:ChamferBorder>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:GamingViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel Margin="0,0,12,24">
                <WrapPanel>
                    <ContentControl Content="{Binding Cpu}" ContentTemplate="{StaticResource GamingTileTemplate}" Focusable="False" />
                    <ContentControl Content="{Binding Gpu}" ContentTemplate="{StaticResource GamingTileTemplate}" Focusable="False" />
                    <ContentControl Content="{Binding Ram}" ContentTemplate="{StaticResource GamingTileTemplate}" Focusable="False" />
                    <ContentControl Content="{Binding Vram}" ContentTemplate="{StaticResource GamingTileTemplate}" Focusable="False" />
                    <ContentControl Content="{Binding GpuTemp}" ContentTemplate="{StaticResource GamingTileTemplate}" Focusable="False" />
                    <ContentControl Content="{Binding CpuTemp}" ContentTemplate="{StaticResource GamingTileTemplate}" Focusable="False" />
                    <ContentControl Content="{Binding Clock}" ContentTemplate="{StaticResource GamingTileTemplate}" Focusable="False" />
                    <ContentControl Content="{Binding Network}" ContentTemplate="{StaticResource GamingTileTemplate}" Focusable="False" />
                    <ContentControl Content="{Binding Display}" ContentTemplate="{StaticResource GamingTileTemplate}" Focusable="False" />
                </WrapPanel>
                <ctl:ChamferBorder Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Series1}" Margin="0,0,6,0" /><TextBlock Text="CPU" Style="{StaticResource Text.Muted}" Margin="0,0,14,0" />
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Series2}" Margin="0,0,6,0" /><TextBlock Text="GPU" Style="{StaticResource Text.Muted}" Margin="0,0,14,0" />
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Series3}" Margin="0,0,6,0" /><TextBlock Text="RAM" Style="{StaticResource Text.Muted}" />
                            </StackPanel>
                            <TextBlock Text="PERFORMANCEVERLAUF · 2 MIN" Style="{StaticResource Text.CardHeader}" />
                        </DockPanel>
                        <ctl:PerformanceChart Height="200" Series1="{Binding CpuHistory}" Series2="{Binding GpuHistory}" Series3="{Binding RamHistory}"
                                              Brush1="{DynamicResource Brush.Series1}" Brush2="{DynamicResource Brush.Series2}" Brush3="{DynamicResource Brush.Series3}"
                                              GridBrush="{DynamicResource Brush.Grid}" LabelBrush="{DynamicResource Brush.TextMuted}" />
                    </StackPanel>
                </ctl:ChamferBorder>
                <TextBlock Style="{StaticResource Text.MutedWrap}" MaxWidth="900" HorizontalAlignment="Left"
                           Text="GPU-Last, VRAM und GPU-Temperatur stammen aus dem Windows-Grafikkernel (wie im Task-Manager) – für AMD, Intel und NVIDIA. CPU-Temperaturen kommen aus ACPI bzw. aus HWiNFO/LibreHardwareMonitor, falls gestartet." />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ===================== Technician Mode (§7) ===================== -->
    <DataTemplate DataType="{x:Type vm:TechnicianViewModel}">
        <Grid Margin="0,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ctl:ChamferBorder Style="{StaticResource Card}" Margin="0" Padding="8">
                <TreeView ItemsSource="{Binding Tree}">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            <Setter Property="Padding" Value="4,4" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:TechNode}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" FontSize="13" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Title}" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </ctl:ChamferBorder>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ctl:ChamferBorder Style="{StaticResource StatusBar}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Wrap}" />
                    </ctl:ChamferBorder>
                    <TextBlock Text="{Binding Selected.Title}" Style="{StaticResource Text.H2}" />
                    <ItemsControl ItemsSource="{Binding Selected.Sections}" ItemTemplate="{StaticResource InfoSectionTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}" />

                    <!-- Command Output Viewer (§87): Originalausgabe + Exit Codes -->
                    <StackPanel Visibility="{Binding ShowCommands, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Letzte Admin-Befehle (Exit Codes &amp; Originalausgabe)" Style="{StaticResource Text.H2}" Margin="0,8,0,10" />
                        <TextBlock Text="Noch keine Admin-Befehle in dieser Sitzung." Style="{StaticResource Text.Muted}"
                                   Visibility="{Binding Commands.Count, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding Commands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding Title}" Margin="0,0,0,6">
                                        <ctl:ChamferBorder Background="{DynamicResource Brush.SurfaceAlt}" Chamfer="6" Padding="10" MaxHeight="300" Margin="0,6,0,0">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0"
                                                         FontFamily="{StaticResource Font.Mono}" FontSize="12" TextWrapping="Wrap" />
                                            </ScrollViewer>
                                        </ctl:ChamferBorder>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DataTemplate>

    <!-- ===================== Visual PC Map (§8, §101) ===================== -->
    <DataTemplate DataType="{x:Type vm:PcMapViewModel}">
        <Viewbox Stretch="Uniform" Margin="0,0,12,12" VerticalAlignment="Top">
            <Canvas Width="1000" Height="640">
                <!-- Verbindungslinien Mitte → Komponenten -->
                <ItemsControl ItemsSource="{Binding Nodes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas Width="1000" Height="640" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Line X1="500" Y1="320" X2="{Binding CenterX}" Y2="{Binding CenterY}" StrokeThickness="2" StrokeDashArray="4 3"
                                  Stroke="{Binding State, Converter={StaticResource StateBrush}}" Opacity="0.6" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Mainboard in der Mitte -->
                <Button Canvas.Left="370" Canvas.Top="235" Width="260" Height="170" Command="{Binding OpenBoardCommand}" ToolTip="Technician Mode öffnen"
                        Background="{DynamicResource Brush.Hero}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="2" Margin="0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE964;" Style="{StaticResource Text.Icon}" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
                        <TextBlock Text="{Binding BoardTitle}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,2" />
                        <TextBlock Text="{Binding BoardDetail}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" MaxWidth="230" />
                        <TextBlock Text="{Binding BoardFirmware}" Style="{StaticResource Text.Muted}" FontSize="10" HorizontalAlignment="Center" MaxWidth="240"
                                   TextTrimming="CharacterEllipsis" Visibility="{Binding BoardFirmware, Converter={StaticResource NullToVis}}" />
                        <TextBlock Text="{Binding BoardScore}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center"
                                   MaxWidth="240" TextTrimming="CharacterEllipsis" Visibility="{Binding BoardScore, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                </Button>

                <!-- Komponenten -->
                <ItemsControl ItemsSource="{Binding Nodes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas Width="1000" Height="640" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="160" Height="80" Margin="0" Padding="10,8" ToolTip="{Binding ToolTipText}"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Canvas, AncestorLevel=2}}"
                                    CommandParameter="{Binding}" Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{Binding State, Converter={StaticResource StateBrush}}" BorderThickness="2">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" FontSize="16" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Device}" Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Load}" Style="{StaticResource Text.Muted}" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- ===================== Admin / Service Mode (§10) ===================== -->
    <Style x:Key="TabItemStyle" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ctl:ChamferBorder x:Name="Bd" Chamfer="8" Padding="12,6" Margin="0,0,6,6" BorderThickness="1"
                            Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}">
                        <ContentPresenter />
                    </ctl:ChamferBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate DataType="{x:Type vm:AdminServiceViewModel}">
        <DockPanel>
            <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource TabItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,12,8">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Title}" /></DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ContentControl Content="{Binding SelectedTab.Page}" Focusable="False" />
        </DockPanel>
    </DataTemplate>

    <!-- ===================== Dienste ===================== -->
    <DataTemplate DataType="{x:Type vm:ServicesViewModel}">
        <DockPanel Margin="0,0,12,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,12,0" ToolTip="Filtern nach Name" />
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding RunningOnly}" Content="Nur laufende" Margin="0,0,12,0" />
                <Button Content="Aktualisieren" Command="{Binding RefreshCommand}" Margin="0" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.MutedWrap}" Margin="0,0,0,8"
                       Text="Nur Anzeige. Orange = Starttyp „Automatisch“, aber nicht gestartet (bei Diensten mit verzögertem oder Trigger-Start normal). Änderungen über die Windows-Diensteverwaltung." />
            <DataGrid ItemsSource="{Binding Rows}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="24">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><Ellipse Style="{StaticResource StatusDot}" Fill="{Binding Health, Converter={StaticResource StateBrush}}" /></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Anzeigename" Binding="{Binding DisplayName}" Width="2*" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140" />
                    <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="90" />
                    <DataGridTextColumn Header="Starttyp" Binding="{Binding StartMode}" Width="110" />
                    <DataGridTextColumn Header="Konto" Binding="{Binding Account}" Width="150" />
                    <DataGridTextColumn Header="Pfad" Binding="{Binding Path}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DataTemplate>

    <!-- ===================== Windows Logs ===================== -->
    <DataTemplate DataType="{x:Type vm:EventsViewModel}">
        <DockPanel Margin="0,0,12,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton Style="{StaticResource Segment}" GroupName="EvLog" Content="System" IsChecked="{Binding LogSystem}" />
                <RadioButton Style="{StaticResource Segment}" GroupName="EvLog" Content="Anwendung" IsChecked="{Binding LogApplication}" />
                <RadioButton Style="{StaticResource Segment}" GroupName="EvLog" Content="Setup" IsChecked="{Binding LogSetup}" />
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IncludeWarnings}" Content="inkl. Warnungen" Margin="12,0,12,6" />
                <Button Content="Aktualisieren" Command="{Binding RefreshCommand}" Margin="0,0,0,6" />
            </StackPanel>
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <DataGrid ItemsSource="{Binding Rows}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="24">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><Ellipse Style="{StaticResource StatusDot}" Fill="{Binding State, Converter={StaticResource StateBrush}}" /></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Zeit" Binding="{Binding Time}" Width="140" />
                    <DataGridTextColumn Header="Stufe" Binding="{Binding Level}" Width="80" />
                    <DataGridTextColumn Header="Quelle" Binding="{Binding Provider}" Width="220" />
                    <DataGridTextColumn Header="Event-ID" Binding="{Binding EventId}" Width="80" />
                    <DataGridTextColumn Header="Meldung" Binding="{Binding Message}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DataTemplate>

    <!-- ===================== Export ===================== -->
    <DataTemplate DataType="{x:Type vm:ExportViewModel}">
        <StackPanel Margin="0,0,12,12" MaxWidth="700" HorizontalAlignment="Left">
            <ctl:ChamferBorder Style="{StaticResource StatusBar}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Wrap}" />
            </ctl:ChamferBorder>
            <ctl:ChamferBorder Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Systembericht" Style="{StaticResource Text.H2}" />
                    <TextBlock Style="{StaticResource Text.MutedWrap}" Margin="0,0,0,10"
                               Text="Windows, CPU, GPU, RAM, Mainboard, Speicher, Netzwerk, Treiber, Updates, Autostart, Health. Sensible Daten sind standardmäßig ausgeblendet." />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Dashboard.IncludeSensitiveInReport}" Content="Sensible Daten einschließen (erfordert Bestätigung)" Margin="0,0,0,10" />
                    <Button Style="{StaticResource Button.Primary}" Content="Systembericht exportieren (TXT/JSON) …" Command="{Binding ExportReportCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </ctl:ChamferBorder>
            <ctl:ChamferBorder Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Logs" Style="{StaticResource Text.H2}" />
                    <Button Content="Aktions- und Security-Log exportieren (TXT/JSON) …" Command="{Binding ExportLogsCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </ctl:ChamferBorder>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
