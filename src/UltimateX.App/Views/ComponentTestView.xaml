<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:UltimateX.App.ViewModels"
                    xmlns:ctl="clr-namespace:UltimateX.App.Controls">

    <Style x:Key="CountTile" TargetType="ctl:ChamferBorder" BasedOn="{StaticResource Card.Inner}">
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinWidth" Value="104" />
    </Style>

    <Style x:Key="InteractiveButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <DataTemplate DataType="{x:Type vm:ComponentTestViewModel}">
        <Grid Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ctl:ChamferBorder Style="{StaticResource StatusBar}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Wrap}" />
            </ctl:ChamferBorder>

            <!-- Kopf: Gesamtstatus + TEST ALL -->
            <ctl:ChamferBorder Grid.Row="1" Background="{DynamicResource Brush.Hero}" BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1"
                               Chamfer="20" AccentBrush="{Binding OverallState, Converter={StaticResource StateBrush}}" AccentLength="70" Padding="22,18" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="SYSTEM COMPONENT TEST CENTER" Style="{StaticResource Text.CardHeader}" Foreground="{DynamicResource Brush.AccentHot}" />
                        <TextBlock Style="{StaticResource Text.Display}" FontSize="32" Margin="0,2,0,10">
                            <Run Text="GESAMT: " /><Run Text="{Binding OverallText, Mode=OneWay}" Foreground="{Binding OverallState, Converter={StaticResource StateBrush}}" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <ctl:ChamferBorder Style="{StaticResource CountTile}" AccentBrush="{DynamicResource Brush.Ok}">
                                <StackPanel><TextBlock Text="PASS" Style="{StaticResource Text.Muted}" FontSize="10" /><TextBlock Text="{Binding PassCount}" Style="{StaticResource Text.Display}" FontSize="22" Foreground="{DynamicResource Brush.Ok}" /></StackPanel>
                            </ctl:ChamferBorder>
                            <ctl:ChamferBorder Style="{StaticResource CountTile}" AccentBrush="{DynamicResource Brush.Warning}">
                                <StackPanel><TextBlock Text="WARNING" Style="{StaticResource Text.Muted}" FontSize="10" /><TextBlock Text="{Binding WarningCount}" Style="{StaticResource Text.Display}" FontSize="22" Foreground="{DynamicResource Brush.Warning}" /></StackPanel>
                            </ctl:ChamferBorder>
                            <ctl:ChamferBorder Style="{StaticResource CountTile}" AccentBrush="{DynamicResource Brush.Problem}">
                                <StackPanel><TextBlock Text="FAIL" Style="{StaticResource Text.Muted}" FontSize="10" /><TextBlock Text="{Binding FailCount}" Style="{StaticResource Text.Display}" FontSize="22" Foreground="{DynamicResource Brush.Problem}" /></StackPanel>
                            </ctl:ChamferBorder>
                            <ctl:ChamferBorder Style="{StaticResource CountTile}" AccentBrush="{DynamicResource Brush.Na}">
                                <StackPanel><TextBlock Text="NOT AVAILABLE" Style="{StaticResource Text.Muted}" FontSize="10" /><TextBlock Text="{Binding NaCount}" Style="{StaticResource Text.Display}" FontSize="22" /></StackPanel>
                            </ctl:ChamferBorder>
                            <ctl:ChamferBorder Style="{StaticResource CountTile}" AccentBrush="{DynamicResource Brush.Warning}">
                                <StackPanel><TextBlock Text="USER ACTION" Style="{StaticResource Text.Muted}" FontSize="10" /><TextBlock Text="{Binding UserActionCount}" Style="{StaticResource Text.Display}" FontSize="22" /></StackPanel>
                            </ctl:ChamferBorder>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Width="380" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.Primary}" Height="58" HorizontalAlignment="Stretch" Command="{Binding RunAllCommand}"
                                IsEnabled="{Binding IsRunningAll, Converter={StaticResource InvBool}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" Style="{StaticResource Text.Icon}" FontSize="20" Margin="0,0,12,0" />
                                <TextBlock Text="TEST ALL SYSTEM COMPONENTS" FontFamily="{StaticResource Font.DisplayCondensed}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Margin="0,10,0,4" Visibility="{Binding IsRunningAll, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.MutedWrap}" FontSize="11" Margin="0,6,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Abbrechen" Command="{Binding CancelRunCommand}" Visibility="{Binding IsRunningAll, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Bericht exportieren (TXT/JSON)" Command="{Binding ExportCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.MutedWrap}" FontSize="11" Margin="0,6,0,0"
                                   Text="Standardmäßig nur sichere, nicht-destruktive Prüfungen. Schreibtest, Kamera, Mikrofon und Testseite nur nach Klick." />
                    </StackPanel>
                </Grid>
            </ctl:ChamferBorder>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- Testliste nach Kategorien -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,4,24">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardHeader}" Foreground="{DynamicResource Brush.AccentHot}" Margin="2,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ctl:ChamferBorder Style="{StaticResource Card.Inner}" Margin="0,0,0,6" AccentBrush="{Binding State, Converter={StaticResource StateBrush}}">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="170" />
                                                                <ColumnDefinition Width="150" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <ctl:ChamferBorder Style="{StaticResource Badge}" BorderBrush="{Binding State, Converter={StaticResource StateBrush}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Ellipse Style="{StaticResource StatusDot}" Width="7" Height="7" Margin="0,0,6,0" Fill="{Binding State, Converter={StaticResource StateBrush}}" />
                                                                    <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding State, Converter={StaticResource StateBrush}}" />
                                                                </StackPanel>
                                                            </ctl:ChamferBorder>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Summary}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" Margin="0,0,10,0" />
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DurationText}" Style="{StaticResource Text.Muted}" FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                <Button Style="{StaticResource Button.Link}" Content="SCHREIBTEST" Margin="0,0,12,0" ToolTip="Optional, nur nach Bestätigung"
                                                                        Visibility="{Binding HasWriteTest, Converter={StaticResource BoolToVis}}"
                                                                        Command="{Binding DataContext.WriteTestCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}" />
                                                                <Button Style="{StaticResource Button.Link}" Content="DETAILS" Margin="0,0,12,0"
                                                                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}"
                                                                        Command="{Binding DataContext.ToggleDetailsCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}" />
                                                                <Button Style="{StaticResource Button.Link}" Content="TEST"
                                                                        Command="{Binding DataContext.RunOneCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <ProgressBar IsIndeterminate="True" Height="2" Margin="0,6,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding DetailsText}" Style="{StaticResource Text.Mono}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,2"
                                                                   Foreground="{DynamicResource Brush.TextMuted}" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </ctl:ChamferBorder>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Interaktive Tests + Verlauf -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ctl:ChamferBorder Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="INTERAKTIVE TESTS" Style="{StaticResource Text.CardHeader}" Margin="0,0,0,4" />
                                <TextBlock Text="Nur auf Klick. Nichts wird aufgenommen oder gespeichert." Style="{StaticResource Text.MutedWrap}" FontSize="11" Margin="0,0,0,10" />
                                <Button Style="{StaticResource InteractiveButton}" Command="{Binding PlaySoundCommand}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE767;" Style="{StaticResource Text.Icon}" Margin="0,0,10,0" /><TextBlock Text="PLAY TEST SOUND" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource InteractiveButton}" Command="{Binding ToggleMicCommand}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE720;" Style="{StaticResource Text.Icon}" Margin="0,0,10,0" /><TextBlock Text="MIKROFON-PEGEL START / STOP" /></StackPanel>
                                </Button>
                                <StackPanel Visibility="{Binding IsMicRunning, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                    <ProgressBar Value="{Binding MicLevel}" Maximum="100" Height="10" Foreground="{DynamicResource Brush.AccentHot}" />
                                    <TextBlock Style="{StaticResource Text.Muted}" FontSize="11">
                                        <Run Text="Spitze: " /><Run Text="{Binding MicPeak, StringFormat='{}{0:0} %', Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <Button Style="{StaticResource InteractiveButton}" Command="{Binding CameraTestCommand}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE722;" Style="{StaticResource Text.Icon}" Margin="0,0,10,0" /><TextBlock Text="KAMERA PRÜFEN" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource InteractiveButton}" Command="{Binding ColorTestCommand}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F8;" Style="{StaticResource Text.Icon}" Margin="0,0,10,0" /><TextBlock Text="BILDSCHIRM-FARBTEST" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource InteractiveButton}" Command="{Binding InputTestCommand}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE765;" Style="{StaticResource Text.Icon}" Margin="0,0,10,0" /><TextBlock Text="TASTATUR- &amp; MAUSTEST" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource InteractiveButton}" Command="{Binding PrintTestPageCommand}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE749;" Style="{StaticResource Text.Icon}" Margin="0,0,10,0" /><TextBlock Text="WINDOWS-TESTSEITE DRUCKEN" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource InteractiveButton}" Command="{Binding MemoryDiagnosticCommand}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE964;" Style="{StaticResource Text.Icon}" Margin="0,0,10,0" /><TextBlock Text="WINDOWS-SPEICHERDIAGNOSE" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </ctl:ChamferBorder>

                        <ctl:ChamferBorder Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="TESTVERLAUF" Style="{StaticResource Text.CardHeader}" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding HistoryText, TargetNullValue='Noch kein Testlauf gespeichert.'}" Style="{StaticResource Text.MutedWrap}" FontSize="11" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Changes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Text.Wrap}" FontSize="12" Margin="0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ctl:ChamferBorder>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
