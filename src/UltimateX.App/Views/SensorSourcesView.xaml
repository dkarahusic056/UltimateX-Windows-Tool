<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:UltimateX.App.ViewModels"
                    xmlns:ctl="clr-namespace:UltimateX.App.Controls">

    <DataTemplate DataType="{x:Type vm:SensorSourcesViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ctl:ChamferBorder Style="{StaticResource StatusBar}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Wrap}" />
            </ctl:ChamferBorder>

            <!-- Kopf: aktive Quellen + Aktionen -->
            <DockPanel Grid.Row="1" Margin="0,0,12,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Einrichtung" Command="{Binding ShowSetupHelpCommand}" Margin="0,0,8,0" />
                    <Button Content="Min/Ø/Max zurücksetzen" Command="{Binding ResetStatisticsCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="AKTIVE QUELLEN" Style="{StaticResource Text.CardHeader}" />
                    <TextBlock Text="{Binding ActiveSourceText}" Style="{StaticResource Text.Display}" FontSize="20" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Muted}" />
                </StackPanel>
            </DockPanel>

            <!-- Quellenkarten in Prioritätsreihenfolge -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Sources}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ctl:ChamferBorder Style="{StaticResource Card}" AccentBrush="{Binding State, Converter={StaticResource StateBrush}}">
                            <StackPanel>
                                <DockPanel>
                                    <ctl:ChamferBorder DockPanel.Dock="Right" Style="{StaticResource Badge}" BorderBrush="{Binding State, Converter={StaticResource StateBrush}}">
                                        <TextBlock Text="{Binding StateText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding State, Converter={StaticResource StateBrush}}" />
                                    </ctl:ChamferBorder>
                                    <TextBlock Text="{Binding PriorityText}" Style="{StaticResource Text.Muted}" FontSize="11" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H3}" Margin="0,8,0,2" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Counts}" Style="{StaticResource Text.Muted}" FontSize="11" />
                                <TextBlock Style="{StaticResource Text.Muted}" FontSize="11">
                                    <Run Text="Letzte Aktualisierung: " /><Run Text="{Binding LastUpdateText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.MutedWrap}" FontSize="11" Margin="0,8,0,0" MinHeight="44" />
                                <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Mono}" FontSize="10" Margin="0,8,0,0"
                                           Foreground="{Binding State, Converter={StaticResource StateBrush}}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Headline}" />
                            </StackPanel>
                        </ctl:ChamferBorder>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Einheitliches Sensormodell -->
            <Grid Grid.Row="3" Margin="0,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>
                <ctl:ChamferBorder Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <ComboBox DockPanel.Dock="Right" Width="170" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" />
                            <TextBlock Text="UNIFIED SENSOR MODEL" Style="{StaticResource Text.CardHeader}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding Sensors}" SelectedItem="{Binding SelectedSensor}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="260">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="22">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding State, Converter={StaticResource StateBrush}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Sensor" Binding="{Binding Code}" Width="150" FontFamily="{StaticResource Font.Mono}" />
                                <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Label}" Width="*" />
                                <DataGridTextColumn Header="Hardware" Binding="{Binding Hardware}" Width="*" />
                                <DataGridTextColumn Header="Aktuell" Binding="{Binding Current}" Width="90" />
                                <DataGridTextColumn Header="Min" Binding="{Binding Min}" Width="80" />
                                <DataGridTextColumn Header="Ø" Binding="{Binding Average}" Width="80" />
                                <DataGridTextColumn Header="Max" Binding="{Binding Max}" Width="80" />
                                <DataGridTextColumn Header="Quelle" Binding="{Binding Source}" Width="150" />
                                <DataGridTextColumn Header="Stand" Binding="{Binding LastUpdate}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </ctl:ChamferBorder>

                <!-- Sensordetails -->
                <ctl:ChamferBorder Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="SENSOR DETAILS" Style="{StaticResource Text.CardHeader}" Margin="0,0,0,8" />
                        <TextBlock Text="Einen Sensor in der Tabelle auswählen." Style="{StaticResource Text.MutedWrap}"
                                   Visibility="{Binding SelectedSensor, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                        <StackPanel Visibility="{Binding SelectedSensor, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding SelectedSensor.Code}" Style="{StaticResource Text.Mono}" Foreground="{DynamicResource Brush.AccentHot}" />
                            <TextBlock Text="{Binding SelectedSensor.Label}" Style="{StaticResource Text.H3}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedSensor.Hardware}" Style="{StaticResource Text.MutedWrap}" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding SelectedSensor.Current}" Style="{StaticResource Text.Display}" FontSize="38"
                                       Foreground="{Binding SelectedSensor.State, Converter={StaticResource StateBrush}}" />
                            <ctl:Sparkline Height="70" Margin="0,8,0,10" Values="{Binding SelectedHistory}"
                                           Stroke="{DynamicResource Brush.AccentHot}" Fill="{DynamicResource Brush.ChartFill}" />
                            <UniformGrid Columns="3" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="MIN" Style="{StaticResource Text.Muted}" FontSize="10" />
                                    <TextBlock Text="{Binding SelectedSensor.Min}" Style="{StaticResource Text.Value}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Ø" Style="{StaticResource Text.Muted}" FontSize="10" />
                                    <TextBlock Text="{Binding SelectedSensor.Average}" Style="{StaticResource Text.Value}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="MAX" Style="{StaticResource Text.Muted}" FontSize="10" />
                                    <TextBlock Text="{Binding SelectedSensor.Max}" Style="{StaticResource Text.Value}" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource Text.Muted}">
                                <Run Text="Quelle: " /><Run Text="{Binding SelectedSensor.Source, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Text.Muted}">
                                <Run Text="Letzte Aktualisierung: " /><Run Text="{Binding SelectedSensor.LastUpdate, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </ctl:ChamferBorder>
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
