<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:UltimateX.App.ViewModels"
                    xmlns:ctl="clr-namespace:UltimateX.App.Controls">

    <!-- v1.2: Memory Test, Storage, Gaming Check, Can My PC Run It, Upgrade Advisor, BIOS/UEFI, New PC Setup,
         Open Source Security, System Snapshot. Gemeinsame Vorlagen (FindingTemplate, ScoreRowTemplate, StepRowTemplate)
         liegen in Themes/Templates.xaml. -->

    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.CardHeader}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentHot}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="HeroCard" TargetType="ctl:ChamferBorder">
        <Setter Property="Background" Value="{DynamicResource Brush.Hero}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Chamfer" Value="20" />
        <Setter Property="AccentLength" Value="70" />
        <Setter Property="Padding" Value="22,18" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <DataTemplate x:Key="InfoItemListTemplate">
        <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource InfoItemTemplate}" />
    </DataTemplate>

    <!-- ===================== MEMORY TEST (§5) ===================== -->
    <DataTemplate DataType="{x:Type vm:MemoryTestViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel Margin="0,0,12,24">
                <ctl:ChamferBorder Style="{StaticResource StatusBar}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Wrap}" />
                </ctl:ChamferBorder>
                <ctl:ChamferBorder Style="{StaticResource HeroCard}" AccentBrush="{Binding ResultState, Converter={StaticResource StateBrush}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="400" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="RAM STABILITY TEST" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="{Binding ResultText}" Style="{StaticResource Text.Display}" FontSize="36" Foreground="{Binding ResultState, Converter={StaticResource StateBrush}}" />
                            <ProgressBar Value="{Binding Percent}" Maximum="100" Height="6" Margin="0,8,0,8" Width="520" HorizontalAlignment="Left" />
                            <Grid Width="520" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Phase" Style="{StaticResource Text.Muted}" />
                                <TextBlock Grid.Column="1" Text="{Binding Phase}" />
                                <TextBlock Grid.Row="1" Text="Passes" Style="{StaticResource Text.Muted}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PassText}" />
                                <TextBlock Grid.Row="2" Text="Test Pattern" Style="{StaticResource Text.Muted}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PatternText}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="3" Text="Getesteter Speicher" Style="{StaticResource Text.Muted}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TestedText}" />
                                <TextBlock Grid.Row="4" Text="Error Count" Style="{StaticResource Text.Muted}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ErrorText}" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="5" Text="Testdauer" Style="{StaticResource Text.Muted}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DurationText}" />
                            </Grid>
                            <TextBlock Text="{Binding ResultNote}" Style="{StaticResource Text.MutedWrap}" Margin="0,10,0,0" MaxWidth="620" HorizontalAlignment="Left"
                                       Visibility="{Binding ResultNote, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <ListBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" Background="Transparent" BorderThickness="0"
                                     IsEnabled="{Binding IsRunning, Converter={StaticResource InvBool}}" Margin="0,0,0,8">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2,0,4">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.MutedWrap}" FontSize="11" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,0,0,8">
                                <Run Text="Gewählt: " /><Run Text="{Binding SelectedMode.Label, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Button.Primary}" Content="Test starten" Command="{Binding StartCommand}" IsEnabled="{Binding IsRunning, Converter={StaticResource InvBool}}" />
                                <Button Content="Abbrechen" Command="{Binding CancelCommand}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <TextBlock Text="BOOT MEMORY TEST" Style="{StaticResource SectionHeader}" Margin="0,16,0,6" />
                            <TextBlock Style="{StaticResource Text.MutedWrap}" FontSize="11" Margin="0,0,0,8"
                                       Text="Testet außerhalb von Windows nahezu den gesamten Arbeitsspeicher (Windows-Speicherdiagnose, Prinzip wie MemTest86). Erfordert einen Neustart." />
                            <Button Content="Boot-Test planen …" Command="{Binding BootTestCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                </ctl:ChamferBorder>

                <WrapPanel>
                    <ctl:ChamferBorder Style="{StaticResource Card}" Width="560" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="RAM-KONFIGURATION" Style="{StaticResource SectionHeader}" />
                            <ItemsControl ItemsSource="{Binding Configuration}" ItemTemplate="{StaticResource InfoItemTemplate}" />
                        </StackPanel>
                    </ctl:ChamferBorder>
                    <ctl:ChamferBorder Style="{StaticResource Card}" Width="560" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="BOOT MEMORY TEST – ERGEBNISSE" Style="{StaticResource SectionHeader}" />
                            <ItemsControl ItemsSource="{Binding BootResults}" ItemTemplate="{StaticResource InfoItemTemplate}" />
                        </StackPanel>
                    </ctl:ChamferBorder>
                </WrapPanel>

                <ctl:ChamferBorder Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="FEHLER (ERROR ADDRESS)" Style="{StaticResource SectionHeader}" />
                        <TextBlock Style="{StaticResource Text.MutedWrap}" FontSize="11" Margin="0,0,0,8"
                                   Text="Adressen sind virtuelle Adressen des Testpuffers (Windows gibt physische Adressen nicht preis). Für die Zuordnung zu einem Modul: Module einzeln testen." />
                        <DataGrid ItemsSource="{Binding Errors}" MaxHeight="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Adresse" Binding="{Binding Address}" Width="150" />
                                <DataGridTextColumn Header="Muster" Binding="{Binding Pattern}" Width="160" />
                                <DataGridTextColumn Header="Pass" Binding="{Binding Pass}" Width="60" />
                                <DataGridTextColumn Header="Erwartet" Binding="{Binding Expected}" Width="190" />
                                <DataGridTextColumn Header="Gelesen" Binding="{Binding Actual}" Width="190" />
                                <DataGridTextColumn Header="Bits" Binding="{Binding Bits}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ctl:ChamferBorder>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ===================== STORAGE / DRIVE HEALTH (§7) ===================== -->
    <DataTemplate DataType="{x:Type vm:StorageViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel Margin="0,0,12,24">
                <ctl:ChamferBorder Style="{StaticResource StatusBar}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Wrap}" />
                </ctl:ChamferBorder>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Style="{StaticResource Button.Primary}" Content="SMART lesen (UAC)" Command="{Binding ReadSmartCommand}" />
                    <Button Content="Aktualisieren" Command="{Binding RefreshCommand}" />
                    <TextBlock Text="{Binding SmartInfo}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="8,0,0,8" />
                </StackPanel>
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Drives}" ItemsPanel="{StaticResource WrapPanelTemplate}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ctl:ChamferBorder Style="{StaticResource Card}" Width="560" VerticalAlignment="Top" AccentBrush="{Binding State, Converter={StaticResource StateBrush}}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Verdict}" Style="{StaticResource Text.Display}" FontSize="22"
                                                   Foreground="{Binding State, Converter={StaticResource StateBrush}}" />
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H3}" FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource InfoItemTemplate}" />
                                    <TextBlock Text="{Binding Reasons}" Style="{StaticResource Text.MutedWrap}" FontSize="11" Margin="0,8,0,0" />
                                </StackPanel>
                            </ctl:ChamferBorder>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ctl:ChamferBorder Style="{StaticResource Card}" Width="560" HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="VOLUMES" Style="{StaticResource SectionHeader}" />
                        <ItemsControl ItemsSource="{Binding Volumes}" ItemTemplate="{StaticResource InfoItemTemplate}" />
                    </StackPanel>
                </ctl:ChamferBorder>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ===================== GAMING CHECK (§12) ===================== -->
    <DataTemplate DataType="{x:Type vm:GamingCheckViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel Margin="0,0,12,24">
                <ctl:ChamferBorder Style="{StaticResource StatusBar}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Wrap}" />
                </ctl:ChamferBorder>
                <ctl:ChamferBorder Style="{StaticResource HeroCard}" AccentBrush="{Binding ScoreState, Converter={StaticResource StateBrush}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button Content="Spielmodus" Command="{Binding OpenGameModeCommand}" />
                            <Button Content="Grafikeinstellungen (HAGS)" Command="{Binding OpenGraphicsSettingsCommand}" />
                            <Button Content="Energieeinstellungen" Command="{Binding OpenPowerSettingsCommand}" />
                            <Button Content="Can My PC Run It" Command="{Binding OpenCanRunCommand}" />
                            <Button Content="Neu prüfen" Command="{Binding RefreshCommand}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="GAMING SCORE" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="{Binding Score}" Style="{StaticResource Text.Display}" FontSize="44" Foreground="{Binding ScoreState, Converter={StaticResource StateBrush}}" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Wrap}" />
                            <TextBlock Style="{StaticResource Text.MutedWrap}" FontSize="11" Margin="0,8,0,0" MaxWidth="640" HorizontalAlignment="Left"
                                       Text="CPU-/GPU-Klassen sind Schätzungen aus der lokalen Hardware-Datenbank. Temperaturen stammen aus dem letzten Benchmark bzw. den Sensoren. ULTIMATE X ändert keine Einstellungen automatisch." />
                        </StackPanel>
                    </DockPanel>
                </ctl:ChamferBorder>
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingTemplate}" />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ===================== CAN MY PC RUN IT? (§13–§17) ===================== -->
    <DataTemplate DataType="{x:Type vm:CanRunViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel Margin="0,0,12,24">
                <ctl:ChamferBorder Style="{StaticResource StatusBar}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Wrap}" />
                </ctl:ChamferBorder>
                <ctl:ChamferBorder Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="CAN MY PC RUN IT?" Style="{StaticResource SectionHeader}" />
                        <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap"><Run Text="MEIN PC: " FontWeight="SemiBold" /><Run Text="{Binding MyPc, Mode=OneWay}" /></TextBlock>
                        <DockPanel Margin="0,10,0,0">
                            <Button DockPanel.Dock="Right" Content="Anforderungen im Web suchen" Command="{Binding SearchRequirementsCommand}" Margin="8,0,0,8" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Online suchen" Command="{Binding OnlineSearchCommand}"
                                    IsEnabled="{Binding IsOnlineBusy, Converter={StaticResource InvBool}}" Margin="8,0,0,8"
                                    ToolTip="Anforderungen aus dem Steam-Shop laden und lokal speichern (ohne Steam-Konto)" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Spiel eingeben, z. B. Cyberpunk 2077 – Enter sucht online" Margin="0,0,0,8">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding OnlineSearchCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                        <DockPanel Visibility="{Binding IsOnlineBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Abbrechen" Command="{Binding CancelOnlineCommand}" Margin="8,0,0,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding OnlineProgress}" Style="{StaticResource Text.MutedWrap}" />
                                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding NotFound}" Style="{StaticResource Text.MutedWrap}" Foreground="{DynamicResource Brush.Warning}"
                                   Visibility="{Binding NotFound, Converter={StaticResource NullToVis}}" />
                        <ListBox ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedGame}" MaxHeight="180" DisplayMemberPath="Name" />
                        <TextBlock Text="{Binding DatabaseInfo}" Style="{StaticResource Text.MutedWrap}" FontSize="10" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding OnlinePrivacyNote}" Style="{StaticResource Text.MutedWrap}" FontSize="10" Margin="0,2,0,0" />
                    </StackPanel>
                </ctl:ChamferBorder>

                <ctl:ChamferBorder Style="{StaticResource HeroCard}" AccentBrush="{Binding RatingState, Converter={StaticResource StateBrush}}"
                                   Visibility="{Binding GameTitle, Converter={StaticResource NullToVis}}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Danger}" Content="Gespeichertes Spiel entfernen" Command="{Binding RemoveSavedGameCommand}"
                                    Visibility="{Binding IsSelectedOnline, Converter={StaticResource BoolToVis}}" VerticalAlignment="Top" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding GameTitle}" Style="{StaticResource SectionHeader}" />
                        </DockPanel>
                        <TextBlock Text="{Binding SelectedSource}" Style="{StaticResource Text.MutedWrap}" FontSize="11" Margin="0,0,0,4"
                                   Visibility="{Binding SelectedSource, Converter={StaticResource NullToVis}}" />
                        <TextBlock Style="{StaticResource Text.MutedWrap}" FontSize="11" Margin="0,0,0,6" Visibility="{Binding IsSelectedOnline, Converter={StaticResource BoolToVis}}"
                                   Text="Online-Daten aus dem Steam-Shop: nur ausdrücklich genannte Werte werden übernommen, unbekannte erscheinen als N/A. Raytracing/Upscaling sind dort nicht angegeben." />
                        <TextBlock Text="{Binding RatingText}" Style="{StaticResource Text.Display}" FontSize="36" Foreground="{Binding RatingState, Converter={StaticResource StateBrush}}" />
                        <TextBlock Text="{Binding RatingSummary}" Style="{StaticResource Text.Wrap}" Margin="0,0,0,10" />
                        <DataGrid ItemsSource="{Binding Checks}" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="24">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><Ellipse Style="{StaticResource StatusDot}" Fill="{Binding State, Converter={StaticResource StateBrush}}" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Prüfung" Binding="{Binding Area}" Width="110" />
                                <DataGridTextColumn Header="MEIN PC" Binding="{Binding Mine}" Width="2*" />
                                <DataGridTextColumn Header="MINIMUM" Binding="{Binding Minimum}" Width="2*" />
                                <DataGridTextColumn Header="RECOMMENDED" Binding="{Binding Recommended}" Width="2*" />
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="FPS ESTIMATION (ESTIMATED)" Style="{StaticResource SectionHeader}" Margin="0,16,0,8" />
                        <WrapPanel>
                            <ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution}" Width="110" Margin="0,0,8,8" />
                            <ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality}" Width="110" Margin="0,0,8,8" />
                            <ComboBox ItemsSource="{Binding Upscalers}" SelectedItem="{Binding SelectedUpscaler}" Width="150" Margin="0,0,8,8" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding RayTracing}" Content="Ray Tracing" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock Text="{Binding FpsText}" Style="{StaticResource Text.Display}" FontSize="26" />
                        <TextBlock Text="{Binding FpsLimit}" Style="{StaticResource Text.Muted}" Visibility="{Binding FpsLimit, Converter={StaticResource NullToVis}}" />
                        <ItemsControl ItemsSource="{Binding Targets}" Margin="0,6,0,10">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ctl:ChamferBorder Style="{StaticResource Badge}" BorderBrush="{Binding State, Converter={StaticResource StateBrush}}" Margin="0,0,8,6">
                                        <TextBlock FontSize="11"><Run Text="{Binding Target, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding Text, Mode=OneWay}" /></TextBlock>
                                    </ctl:ChamferBorder>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DataGrid ItemsSource="{Binding FpsTable}" HeadersVisibility="Column" MaxWidth="700" HorizontalAlignment="Left">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Auflösung" Binding="{Binding Resolution}" Width="100" />
                                <DataGridTextColumn Header="Low" Binding="{Binding Low}" Width="*" />
                                <DataGridTextColumn Header="Medium" Binding="{Binding Medium}" Width="*" />
                                <DataGridTextColumn Header="High" Binding="{Binding High}" Width="*" />
                                <DataGridTextColumn Header="Ultra" Binding="{Binding Ultra}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource Text.MutedWrap}" FontSize="11" Margin="0,6,0,0"
                                   Text="Alle FPS-Werte sind Schätzungen (ESTIMATED) auf Basis veröffentlichter Anforderungen und geschätzter Leistungsklassen – echte Werte hängen von Spielszene, Patch und Treiber ab." />
                    </StackPanel>
                </ctl:ChamferBorder>

                <ctl:ChamferBorder Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Erneut suchen" Command="{Binding ScanGamesCommand}" />
                            <Button DockPanel.Dock="Right" Content="Fehlende Anforderungen online laden" Command="{Binding FetchMissingCommand}" Margin="0,0,8,0"
                                    IsEnabled="{Binding IsOnlineBusy, Converter={StaticResource InvBool}}"
                                    ToolTip="Nur für erkannte Spiele ohne Daten: Steam-Spiele per AppID, andere per Name" />
                            <TextBlock Text="INSTALLIERTE SPIELE" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Visibility="{Binding IsOnlineBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Abbrechen" Command="{Binding CancelOnlineCommand}" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding OnlineProgress}" Style="{StaticResource Text.MutedWrap}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding IsScanningGames, Converter={StaticResource BoolToVis}}" />
                        <DataGrid ItemsSource="{Binding InstalledGames}" MaxHeight="420">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="24">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><Ellipse Style="{StaticResource StatusDot}" Fill="{Binding State, Converter={StaticResource StateBrush}}" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Spiel" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Launcher" Binding="{Binding Launcher}" Width="120" />
                                <DataGridTextColumn Header="Größe" Binding="{Binding Size}" Width="80" />
                                <DataGridTextColumn Header="PC Suitability" Binding="{Binding Suitability}" Width="120" />
                                <DataGridTextColumn Header="Erwartete Performance" Binding="{Binding Performance}" Width="2*" />
                                <DataGridTextColumn Header="Möglicher Engpass" Binding="{Binding Bottleneck}" Width="*" />
                                <DataGridTextColumn Header="Empfehlung" Binding="{Binding Recommended}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource Text.MutedWrap}" FontSize="11" Margin="0,6,0,0"
                                   Text="Gelesen werden nur lokale Bibliotheksdateien (Namen, Installationsort) – keine Kontodaten oder Passwörter." />
                        <TextBlock Style="{StaticResource Text.MutedWrap}" FontSize="11" Margin="0,2,0,0"
                                   Text="„Fehlende Anforderungen online laden“ sendet nur den Spielnamen bzw. die Steam-AppID an store.steampowered.com; zwischen den Abrufen wird jeweils 1,5 Sekunden gewartet." />
                    </StackPanel>
                </ctl:ChamferBorder>

                <ctl:ChamferBorder Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="FIND GAMES FOR MY PC" Style="{StaticResource SectionHeader}" />
                        <TextBlock Style="{StaticResource Text.MutedWrap}" Margin="0,0,0,8"
                                   Text="Suchanfragen aus Ihrer Hardware – Klick öffnet die Suche im Standardbrowser. ULTIMATE X ruft dabei selbst nichts ab." />
                        <ItemsControl ItemsSource="{Binding GameQueries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Button.Link}" Content="{Binding}" HorizontalAlignment="Left" Margin="0,2"
                                            Command="{Binding DataContext.OpenQueryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ctl:ChamferBorder>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ===================== UPGRADE ADVISOR (§18) ===================== -->
    <DataTemplate DataType="{x:Type vm:UpgradeAdvisorViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel Margin="0,0,12,24">
                <ctl:ChamferBorder Style="{StaticResource StatusBar}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Wrap}" />
                </ctl:ChamferBorder>
                <ctl:ChamferBorder Style="{StaticResource HeroCard}" AccentBrush="{Binding HeadlineState, Converter={StaticResource StateBrush}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="UPGRADE ADVISOR" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Display}" FontSize="30" Foreground="{Binding HeadlineState, Converter={StaticResource StateBrush}}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Bottleneck}" Style="{StaticResource Text.Wrap}" Margin="0,8,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <ItemsControl ItemsSource="{Binding Scores}" ItemTemplate="{StaticResource ScoreRowTemplate}" />
                            <Button Content="Benchmarks öffnen" Command="{Binding OpenBenchmarksCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </ctl:ChamferBorder>
                <ctl:ChamferBorder Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="EMPFOHLENE AUFRÜSTUNG" Style="{StaticResource SectionHeader}" />
                        <ItemsControl ItemsSource="{Binding Upgrades}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ctl:ChamferBorder Style="{StaticResource Card.Inner}" Margin="0,0,0,6" AccentBrush="{Binding State, Converter={StaticResource StateBrush}}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Component}" Style="{StaticResource Text.Display}" FontSize="18" Width="110" />
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Priority}" Width="80" Foreground="{Binding State, Converter={StaticResource StateBrush}}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Wrap}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </ctl:ChamferBorder>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="OHNE KAUF – ZUERST PRÜFEN" Style="{StaticResource SectionHeader}" Margin="0,12,0,6" />
                        <ItemsControl ItemsSource="{Binding FreeFixes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource Text.Wrap}" Margin="0,2" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ctl:ChamferBorder>
                <ctl:ChamferBorder Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ANALYSE" Style="{StaticResource SectionHeader}" />
                        <ItemsControl ItemsSource="{Binding Analysis}" ItemTemplate="{StaticResource FindingTemplate}" />
                    </StackPanel>
                </ctl:ChamferBorder>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ===================== BIOS / UEFI CENTER (§35) ===================== -->
    <DataTemplate DataType="{x:Type vm:BiosCenterViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel Margin="0,0,12,24">
                <ctl:ChamferBorder Style="{StaticResource StatusBar}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Wrap}" />
                </ctl:ChamferBorder>
                <ctl:ChamferBorder Style="{StaticResource Card.Notice}">
                    <TextBlock Style="{StaticResource Text.Wrap}"
                               Text="Diese Seite analysiert und erklärt nur. ULTIMATE X nimmt keine Änderungen am BIOS/UEFI vor. Änderungen bitte nur nach Anleitung des Mainboard-/PC-Herstellers." />
                </ctl:ChamferBorder>
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingTemplate}" />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ===================== NEW PC SETUP (§19–§33) ===================== -->
    <DataTemplate DataType="{x:Type vm:NewPcSetupViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel Margin="0,0,12,24">
                <ctl:ChamferBorder Style="{StaticResource StatusBar}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Wrap}" />
                </ctl:ChamferBorder>

                <ctl:ChamferBorder Style="{StaticResource HeroCard}" AccentBrush="{DynamicResource Brush.AccentHot}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="380" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="NEW PC SETUP" Style="{StaticResource SectionHeader}" />
                            <TextBlock Style="{StaticResource Text.Wrap}" MaxWidth="640" HorizontalAlignment="Left"
                                       Text="Installationen ausschließlich aus offiziellen Herstellerquellen (Windows-Paket-Manager, Microsoft Store, Office Deployment Tool). Vor jeder Installation: HTTPS, Herstellerdomain, Herausgeber, Version und SHA-256. Keine Portale, Mirrors, Filehoster, Cracks oder Aktivatoren." />
                            <ItemsControl ItemsSource="{Binding SetupSteps}" ItemTemplate="{StaticResource StepRowTemplate}" Margin="0,10,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <Button Style="{StaticResource Button.Primary}" Height="58" HorizontalAlignment="Stretch" Command="{Binding SetUpThisPcCommand}"
                                    IsEnabled="{Binding IsWorking, Converter={StaticResource InvBool}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7B8;" Style="{StaticResource Text.Icon}" FontSize="20" Margin="0,0,12,0" />
                                    <TextBlock Text="SET UP THIS PC" FontFamily="{StaticResource Font.DisplayCondensed}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IncludeClamAv}" Content="ClamAV zusätzlich (optional)" Margin="0,10,0,4" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IncludeBenchmark}" Content="Complete Benchmark ausführen" Margin="0,0,0,8" />
                            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,4,0,4" Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding WorkingText}" Style="{StaticResource Text.MutedWrap}" Visibility="{Binding WorkingText, Converter={StaticResource NullToVis}}" />
                            <Button Content="Abbrechen" Command="{Binding CancelCommand}" Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                </ctl:ChamferBorder>

                <ctl:ChamferBorder Style="{StaticResource Card}">
                    <Expander Header="VOR DER INSTALLATION – PRÜFUNGEN" IsExpanded="True">
                        <StackPanel Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding EnvironmentChecks}" ItemTemplate="{StaticResource FindingTemplate}" />
                            <Button Content="Erneut prüfen" Command="{Binding CheckEnvironmentCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Expander>
                </ctl:ChamferBorder>

                <ctl:ChamferBorder Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="GRAFIKTREIBER" Style="{StaticResource SectionHeader}" />
                        <DockPanel>
                            <Ellipse DockPanel.Dock="Left" Style="{StaticResource StatusDot}" Fill="{Binding GpuDriverState, Converter={StaticResource StateBrush}}" VerticalAlignment="Top" Margin="0,5,8,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding GpuDriverTitle}" FontWeight="SemiBold" Style="{StaticResource Text.Wrap}" />
                                <TextBlock Text="{Binding GpuDriverDetail}" Style="{StaticResource Text.MutedWrap}" Visibility="{Binding GpuDriverDetail, Converter={StaticResource NullToVis}}" />
                            </StackPanel>
                        </DockPanel>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding InstallNvidiaDriver}" Content="Neuesten NVIDIA-Treiber mitinstallieren (bei „Ausgewählte installieren“ und „SET UP THIS PC“)"
                                  Margin="0,10,0,4" Visibility="{Binding NvidiaUpdateAvailable, Converter={StaticResource BoolToVis}}" />
                        <ProgressBar Height="4" Maximum="100" Value="{Binding DriverProgress}" Margin="0,4,0,4" Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button Style="{StaticResource Button.Primary}" Content="NVIDIA-Treiber jetzt installieren" Command="{Binding InstallNvidiaDriverNowCommand}"
                                    Visibility="{Binding NvidiaUpdateAvailable, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding IsWorking, Converter={StaticResource InvBool}}" />
                            <Button Content="AMD Treiber-Download" Command="{Binding OpenAmdDriversCommand}" Visibility="{Binding ShowAmdDriverLink, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Erneut suchen" Command="{Binding CheckGpuDriverCommand}" IsEnabled="{Binding IsWorking, Converter={StaticResource InvBool}}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="NVIDIA: Treiber passend zur erkannten Karte direkt von NVIDIA (Game Ready, WHQL). Vor dem Start wird die Signatur „NVIDIA Corporation“ geprüft." />
                    </StackPanel>
                </ctl:ChamferBorder>

                <ctl:ChamferBorder Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="PROFIL &amp; SOFTWARE" Style="{StaticResource SectionHeader}" />
                        <WrapPanel>
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Width="520" Margin="0,0,8,8" />
                            <Button Content="Profil übernehmen" Command="{Binding ApplyProfileCommand}" />
                            <Button Content="Empfohlene auswählen" Command="{Binding SelectRecommendedCommand}" />
                            <Button Content="Auswahl leeren" Command="{Binding ClearSelectionCommand}" />
                        </WrapPanel>
                        <ctl:ChamferBorder Style="{StaticResource Card.Inner}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Wrap}"><Run Text="RECOMMENDED FOR THIS PC: " FontWeight="SemiBold" /><Run Text="{Binding RecommendedKind, Mode=OneWay}" /></TextBlock>
                                <ItemsControl ItemsSource="{Binding RecommendationNotes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource Text.MutedWrap}" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Nur Empfehlungen (★) – nichts wird ohne Ihre Auswahl installiert." Style="{StaticResource Text.Muted}" FontSize="11" />
                            </StackPanel>
                        </ctl:ChamferBorder>
                        <ctl:ChamferBorder Style="{StaticResource Card.Inner}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="MICROSOFT OFFICE" Style="{StaticResource SectionHeader}" />
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding InstallOffice}" Content="INSTALL MICROSOFT OFFICE (Microsoft 365 Apps, 64-Bit, Office Deployment Tool)" Margin="0,0,0,8" />
                                <WrapPanel IsEnabled="{Binding InstallOffice}">
                                    <CheckBox IsChecked="{Binding OfficeWord}" Content="Word" Margin="0,0,16,8" />
                                    <CheckBox IsChecked="{Binding OfficeExcel}" Content="Excel" Margin="0,0,16,8" />
                                    <CheckBox IsChecked="{Binding OfficePowerPoint}" Content="PowerPoint" Margin="0,0,16,8" />
                                    <CheckBox IsChecked="{Binding OfficeOutlook}" Content="Outlook" Margin="0,0,16,8" />
                                    <CheckBox IsChecked="{Binding OfficeOneNote}" Content="OneNote" Margin="0,0,16,8" />
                                    <CheckBox IsChecked="{Binding OfficeAccess}" Content="Access" Margin="0,0,16,8" />
                                    <ComboBox ItemsSource="{Binding OfficeLanguages}" SelectedItem="{Binding SelectedOfficeLanguage}" Width="160" Margin="0,0,0,8" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Text.MutedWrap}" FontSize="11"
                                           Text="Keine Lizenzumgehung: Die Aktivierung erfolgt mit Ihrem Microsoft-Konto bzw. Ihrer gültigen Lizenz. Die Lizenzbedingungen bestätigen Sie im Office-Setup." />
                            </StackPanel>
                        </ctl:ChamferBorder>
                        <ItemsControl ItemsSource="{Binding Software}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="230" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="★" Foreground="{DynamicResource Brush.AccentHot}" VerticalAlignment="Center"
                                                   Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SourceText}" Style="{StaticResource Text.Muted}" FontSize="10" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding Category}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding InstalledText}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                                        <DockPanel Grid.Column="5">
                                            <Ellipse DockPanel.Dock="Left" Style="{StaticResource StatusDot}" Fill="{Binding State, Converter={StaticResource StateBrush}}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource Text.MutedWrap}" VerticalAlignment="Center" ToolTip="{Binding Description}" />
                                        </DockPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ctl:ChamferBorder>

                <ctl:ChamferBorder Style="{StaticResource Card}">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,0">
                            <Button Style="{StaticResource Button.Primary}" Content="Ausgewählte installieren" Command="{Binding InstallSelectedCommand}"
                                    IsEnabled="{Binding IsWorking, Converter={StaticResource InvBool}}" />
                            <Button Content="Firefox als Standardbrowser …" Command="{Binding SetFirefoxDefaultCommand}" />
                            <Button Content="Windows-/Treiber-Updates" Command="{Binding OpenUpdatesCommand}" />
                            <Button Content="Open Source Security (ClamAV)" Command="{Binding OpenOpenSourceSecurityCommand}" />
                        </WrapPanel>
                        <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource Font.Mono}" FontSize="11" MaxHeight="220"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding Output, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                </ctl:ChamferBorder>

                <ctl:ChamferBorder Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="FIND SOFTWARE FOR MY PC" Style="{StaticResource SectionHeader}" />
                        <TextBlock Style="{StaticResource Text.MutedWrap}" Margin="0,0,0,8" Text="Öffnet eine passende Suche im Standardbrowser (aus CPU, GPU, RAM und Windows erzeugt)." />
                        <ItemsControl ItemsSource="{Binding SoftwareCategories}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Command="{Binding DataContext.OpenSoftwareSearchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ctl:ChamferBorder>

                <ctl:ChamferBorder Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="INSTALLATION LOG" Style="{StaticResource SectionHeader}" />
                        <DataGrid ItemsSource="{Binding InstallLog}" MaxHeight="320">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="24">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><Ellipse Style="{StaticResource StatusDot}" Fill="{Binding State, Converter={StaticResource StateBrush}}" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Zeitpunkt" Binding="{Binding Time}" Width="130" />
                                <DataGridTextColumn Header="Software" Binding="{Binding Software}" Width="2*" />
                                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="100" />
                                <DataGridTextColumn Header="Quelle" Binding="{Binding Source}" Width="*" />
                                <DataGridTextColumn Header="Signatur" Binding="{Binding Signature}" Width="*" />
                                <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="140" />
                                <DataGridTextColumn Header="Exit" Binding="{Binding Exit}" Width="60" />
                                <DataGridTextColumn Header="Ergebnis" Binding="{Binding Result}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ctl:ChamferBorder>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ===================== OPEN SOURCE SECURITY (§27) ===================== -->
    <DataTemplate DataType="{x:Type vm:OpenSourceSecurityViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel Margin="0,0,12,24">
                <ctl:ChamferBorder Style="{StaticResource StatusBar}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Wrap}" />
                </ctl:ChamferBorder>
                <ctl:ChamferBorder Style="{StaticResource Card.Notice}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Windows-Sicherheit öffnen" Command="{Binding OpenDefenderCommand}" />
                        <TextBlock Style="{StaticResource Text.Wrap}" VerticalAlignment="Center"
                                   Text="Microsoft Defender bleibt der primäre Echtzeitschutz. ClamAV ist ein zusätzlicher Scanner auf Anforderung – ULTIMATE X deaktiviert oder verändert Defender nie." />
                    </DockPanel>
                </ctl:ChamferBorder>
                <WrapPanel>
                    <ctl:ChamferBorder Style="{StaticResource Card}" Width="560" VerticalAlignment="Top" AccentBrush="{Binding InstallStateColor, Converter={StaticResource StateBrush}}">
                        <StackPanel>
                            <TextBlock Text="CLAMAV" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="{Binding InstallState}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SignatureState}" Style="{StaticResource Text.Muted}" Margin="0,0,0,10" />
                            <WrapPanel>
                                <Button Content="Projekt online prüfen" Command="{Binding CheckProjectCommand}" />
                                <Button Style="{StaticResource Button.Primary}" Content="ClamAV installieren" Command="{Binding InstallCommand}" />
                                <Button Content="Definitions Update" Command="{Binding UpdateSignaturesCommand}" />
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding ProjectChecks}" ItemTemplate="{StaticResource FindingTemplate}" Margin="0,8,0,0" />
                        </StackPanel>
                    </ctl:ChamferBorder>
                    <ctl:ChamferBorder Style="{StaticResource Card}" Width="560" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="SCAN" Style="{StaticResource SectionHeader}" />
                            <WrapPanel>
                                <Button Style="{StaticResource Button.Primary}" Content="Quick Scan" Command="{Binding QuickScanCommand}" />
                                <Button Content="Full Scan" Command="{Binding FullScanCommand}" />
                                <Button Content="Custom Scan …" Command="{Binding CustomScanCommand}" />
                                <Button Content="USB Scan" Command="{Binding UsbScanCommand}" />
                                <Button Content="Download Folder Scan" Command="{Binding DownloadsScanCommand}" />
                            </WrapPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding UseQuarantine}" Content="Funde in Quarantäne verschieben" Margin="0,4,0,8" />
                            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,6" Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Abbrechen" Command="{Binding CancelCommand}" Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Left" />
                            <ItemsControl ItemsSource="{Binding Found}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource Brush.Problem}" TextWrapping="Wrap" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right" Content="Quarantäne öffnen" Command="{Binding OpenQuarantineCommand}" />
                                <TextBlock Style="{StaticResource Text.Muted}" VerticalAlignment="Center"><Run Text="Quarantäne: " /><Run Text="{Binding Quarantine.Count, Mode=OneWay}" /><Run Text=" Datei(en)" /></TextBlock>
                            </DockPanel>
                        </StackPanel>
                    </ctl:ChamferBorder>
                </WrapPanel>
                <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource Font.Mono}" FontSize="11" MaxHeight="260"
                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="{Binding Output, Converter={StaticResource NullToVis}}" />
                <ctl:ChamferBorder Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="SCAN HISTORY" Style="{StaticResource SectionHeader}" />
                        <DataGrid ItemsSource="{Binding History}" MaxHeight="320">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="24">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><Ellipse Style="{StaticResource StatusDot}" Fill="{Binding State, Converter={StaticResource StateBrush}}" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Zeitpunkt" Binding="{Binding Time}" Width="130" />
                                <DataGridTextColumn Header="Art" Binding="{Binding Kind}" Width="90" />
                                <DataGridTextColumn Header="Ziel" Binding="{Binding Target}" Width="2*" />
                                <DataGridTextColumn Header="Dateien" Binding="{Binding Files}" Width="80" />
                                <DataGridTextColumn Header="Funde" Binding="{Binding Found}" Width="60" />
                                <DataGridTextColumn Header="Ergebnis" Binding="{Binding Summary}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ctl:ChamferBorder>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ===================== SYSTEM SNAPSHOT (§38) ===================== -->
    <DataTemplate DataType="{x:Type vm:SnapshotViewModel}">
        <DockPanel Margin="0,0,12,12">
            <StackPanel DockPanel.Dock="Top">
                <ctl:ChamferBorder Style="{StaticResource StatusBar}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Wrap}" />
                </ctl:ChamferBorder>
                <ctl:ChamferBorder Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="SYSTEM SNAPSHOT" Style="{StaticResource SectionHeader}" />
                        <TextBlock Style="{StaticResource Text.MutedWrap}" Margin="0,0,0,8"
                                   Text="Erfasst Hardware, Treiber, Programme, Windows-Version, Dienste, Autostart, Netzwerk, Ereignisse und Updates – ohne IP-/MAC-Adressen, Seriennummern oder Benutzerdaten. Gespeichert lokal im Benutzerprofil." />
                        <WrapPanel>
                            <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,8,8" ToolTip="Bezeichnung, z. B. „Vor Treiber-Update“" />
                            <Button Style="{StaticResource Button.Primary}" Content="Snapshot erstellen" Command="{Binding CreateCommand}" />
                            <Button Content="Ordner öffnen" Command="{Binding OpenFolderCommand}" />
                            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,0,8" />
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock Text="BEFORE" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,8,8" />
                            <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding Before}" Width="320" Margin="0,0,16,8" />
                            <TextBlock Text="AFTER" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,8,8" />
                            <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding After}" Width="320" Margin="0,0,8,8" />
                            <Button Content="Vergleichen" Command="{Binding CompareCommand}" />
                        </WrapPanel>
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Summary}" ItemTemplate="{StaticResource InfoItemTemplate}" />
                    </StackPanel>
                </ctl:ChamferBorder>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Changes}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="24">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><Ellipse Style="{StaticResource StatusDot}" Fill="{Binding State, Converter={StaticResource StateBrush}}" /></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Bereich" Binding="{Binding Section}" Width="110" />
                    <DataGridTextColumn Header="Änderung" Binding="{Binding Kind}" Width="90" />
                    <DataGridTextColumn Header="Eintrag" Binding="{Binding Key}" Width="2*" />
                    <DataGridTextColumn Header="BEFORE" Binding="{Binding Before}" Width="2*" />
                    <DataGridTextColumn Header="AFTER" Binding="{Binding After}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
