<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:UltimateX.App.ViewModels"
                    xmlns:ctl="clr-namespace:UltimateX.App.Controls">

    <DataTemplate DataType="{x:Type vm:ReportViewModel}">
        <Grid Margin="0,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Optionen -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <StackPanel Margin="0,0,4,24">
                    <ctl:ChamferBorder Style="{StaticResource StatusBar}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Wrap}" />
                    </ctl:ChamferBorder>

                    <ctl:ChamferBorder Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="PC REPORT" Style="{StaticResource Text.CardHeader}" Foreground="{DynamicResource Brush.AccentHot}" />
                            <TextBlock Text="{Binding PageCount, StringFormat='{}{0} Seiten · A4'}" Style="{StaticResource Text.Display}" FontSize="22" Margin="0,2,0,4" />
                            <TextBlock Text="{Binding DataStamp}" Style="{StaticResource Text.MutedWrap}" FontSize="11" Margin="0,0,0,12" />
                            <Button Style="{StaticResource Button.Primary}" Height="50" HorizontalAlignment="Stretch" Margin="0,0,0,8" Command="{Binding ExportPdfCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA90;" Style="{StaticResource Text.Icon}" FontSize="18" Margin="0,0,10,0" />
                                    <TextBlock Text="EXPORT PC REPORT (PDF)" FontFamily="{StaticResource Font.DisplayCondensed}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Height="46" HorizontalAlignment="Stretch" Margin="0,0,0,8" Command="{Binding PrintCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE749;" Style="{StaticResource Text.Icon}" FontSize="18" Margin="0,0,10,0" />
                                    <TextBlock Text="PRINT PC REPORT" FontFamily="{StaticResource Font.DisplayCondensed}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Content="Daten neu erheben" Command="{Binding RecollectCommand}" HorizontalAlignment="Stretch" />
                            <TextBlock Style="{StaticResource Text.MutedWrap}" FontSize="11" Margin="0,8,0,0"
                                       Text="Drucken öffnet den Windows-Druckdialog – dort ist auch „Microsoft Print to PDF“ wählbar." />
                        </StackPanel>
                    </ctl:ChamferBorder>

                    <ctl:ChamferBorder Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ABSCHNITTE" Style="{StaticResource Text.CardHeader}" Margin="0,0,0,10" />
                            <CheckBox Style="{StaticResource Switch}" Content="Hardware" IsChecked="{Binding Hardware}" Margin="0,0,0,8" />
                            <CheckBox Style="{StaticResource Switch}" Content="Sensoren" IsChecked="{Binding Sensors}" Margin="0,0,0,8" />
                            <CheckBox Style="{StaticResource Switch}" Content="Netzwerk" IsChecked="{Binding Network}" Margin="0,0,0,8" />
                            <CheckBox Style="{StaticResource Switch}" Content="Sicherheit" IsChecked="{Binding Security}" Margin="0,0,0,8" />
                            <CheckBox Style="{StaticResource Switch}" Content="Treiber" IsChecked="{Binding Drivers}" Margin="0,0,0,8" />
                            <CheckBox Style="{StaticResource Switch}" Content="Windows Health" IsChecked="{Binding WindowsHealth}" Margin="0,0,0,8" />
                            <CheckBox Style="{StaticResource Switch}" Content="Komponententests" IsChecked="{Binding ComponentTests}" Margin="0,0,0,8" />
                            <CheckBox Style="{StaticResource Switch}" Content="Benchmarks" IsChecked="{Binding Benchmarks}" Margin="0,0,0,8" />
                            <CheckBox Style="{StaticResource Switch}" Content="Absturzanalyse" IsChecked="{Binding CrashAnalysis}" Margin="0,0,0,8" />
                            <Button Style="{StaticResource Button.Link}" Content="Komponententest jetzt ausführen" Command="{Binding OpenComponentTestsCommand}" Margin="0,4,0,0" />
                        </StackPanel>
                    </ctl:ChamferBorder>

                    <ctl:ChamferBorder Style="{StaticResource Card}" AccentBrush="{DynamicResource Brush.Ok}">
                        <StackPanel>
                            <TextBlock Text="DATENSCHUTZ" Style="{StaticResource Text.CardHeader}" Margin="0,0,0,10" />
                            <CheckBox Style="{StaticResource Switch}" Content="Datenschutzmodus (empfohlen)" IsChecked="{Binding PrivacyMode}" Margin="0,0,0,6" />
                            <TextBlock Text="Abschalten erfordert eine Bestätigung per Windows Hello." Style="{StaticResource Text.MutedWrap}" FontSize="11" Margin="0,0,0,10" />
                            <TextBlock Text="Dieser Bericht enthält:" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Included}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <TextBlock DockPanel.Dock="Left" Text="•" Foreground="{DynamicResource Brush.AccentHot}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding}" Style="{StaticResource Text.MutedWrap}" FontSize="11" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ctl:ChamferBorder>
                </StackPanel>
            </ScrollViewer>

            <!-- Vorschau -->
            <Border Grid.Column="1" Background="{DynamicResource Brush.Sidebar}" Margin="4,0,0,12">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,16">
                        <ItemsControl ItemsSource="{Binding Pages}" HorizontalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,18" Background="White" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" MaxWidth="720">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="Black" />
                                        </Border.Effect>
                                        <Image Source="{Binding}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <ctl:ChamferBorder Style="{StaticResource Card.Raised}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"
                                       Visibility="{Binding IsRendering, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ProgressBar IsIndeterminate="True" Width="80" Height="3" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Vorschau wird erstellt …" />
                        </StackPanel>
                    </ctl:ChamferBorder>
                </Grid>
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
