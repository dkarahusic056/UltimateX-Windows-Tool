<ResourceDictionary xmlns:ctl="clr-namespace:UltimateX.App.Controls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:UltimateX.App.ViewModels">

    <DataTemplate DataType="{x:Type vm:SecurityViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel Margin="0,0,0,24">
                <ctl:ChamferBorder Style="{StaticResource StatusBar}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Wrap}" />
                </ctl:ChamferBorder>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Windows-Sicherheit öffnen" Command="{Binding OpenWindowsSecurityCommand}" />
                    <Button Content="Firewall-Einstellungen" Command="{Binding OpenFirewallCommand}" />
                    <Button Content="Aktualisieren" Command="{Binding RefreshCommand}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Items}" ItemsPanel="{StaticResource WrapPanelTemplate}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ctl:ChamferBorder Style="{StaticResource Card}" Width="300" Height="112">
                                <StackPanel>
                                    <DockPanel>
                                        <Ellipse DockPanel.Dock="Right" Style="{StaticResource StatusDot}" Margin="0" Width="11" Height="11"
                                                 Fill="{Binding State, Converter={StaticResource StateBrush}}" />
                                        <TextBlock Text="{Binding Area}" Style="{StaticResource Text.Muted}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Status}" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,2" Style="{StaticResource Text.Wrap}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Muted}" ToolTip="{Binding Detail}" />
                                </StackPanel>
                            </ctl:ChamferBorder>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ctl:ChamferBorder Style="{StaticResource Card.Notice}" MaxWidth="940" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource Text.Wrap}"
                               Text="ULTIMATE X liest diese Werte nur. Defender, Firewall, Secure Boot, TPM und BitLocker werden niemals automatisch verändert oder deaktiviert; BitLocker-Wiederherstellungsschlüssel werden nie gelesen. Ein grüner Status bedeutet „Schutzfunktion aktiv“ – nicht, dass der PC unangreifbar ist." />
                </ctl:ChamferBorder>

                <!-- File Signature Checker + Hash Tool (§78, §79) -->
                <TextBlock Text="Datei prüfen (Signatur &amp; Hash)" Style="{StaticResource Text.H2}" Margin="0,8,0,10" />
                <ctl:ChamferBorder Style="{StaticResource Card}" MaxWidth="940" HorizontalAlignment="Left">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Primary}" Content="Datei auswählen …" Command="{Binding CheckFileCommand}" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IncludeLegacyMd5}" Content="MD5 zusätzlich (Legacy, nicht sicher)" Margin="8,0,0,8" />
                        </StackPanel>
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.Muted}" Margin="0,0,0,8" Visibility="{Binding FileName, Converter={StaticResource NullToVis}}" />
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding FileResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Muted}" />
                                        <DockPanel Grid.Column="1">
                                            <Ellipse DockPanel.Dock="Left" Style="{StaticResource StatusDot}" Fill="{Binding State, Converter={StaticResource StateBrush}}" />
                                            <!-- TextBox statt TextBlock, damit Hashes markiert und kopiert werden können -->
                                            <TextBox Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                                     FontFamily="{StaticResource Font.Mono}" FontSize="12" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Text.MutedWrap}" Margin="0,8,0,0"
                                   Text="Die ausgewählte Datei wird nur gelesen und niemals ausgeführt. Windows-Systemdateien sind häufig katalogsigniert und zeigen deshalb „Keine eingebettete Signatur“." />
                    </StackPanel>
                </ctl:ChamferBorder>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
