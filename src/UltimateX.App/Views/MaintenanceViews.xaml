<ResourceDictionary xmlns:ctl="clr-namespace:UltimateX.App.Controls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:UltimateX.App.ViewModels">

    <!-- ===================== Speicher bereinigen (§52) ===================== -->
    <DataTemplate DataType="{x:Type vm:CleanupViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel Margin="0,0,12,24" MaxWidth="1000" HorizontalAlignment="Left">
                <ctl:ChamferBorder Style="{StaticResource StatusBar}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Wrap}" />
                </ctl:ChamferBorder>
                <ctl:ChamferBorder Style="{StaticResource Card.Notice}">
                    <TextBlock Style="{StaticResource Text.Wrap}"
                               Text="Es werden nur feste, von Windows als temporär definierte Orte bereinigt. Dokumente, Desktop, Downloads und Bilder sind niemals betroffen. Vor dem Löschen sehen Sie Dateianzahl, Größe und Pfade." />
                </ctl:ChamferBorder>
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ctl:ChamferBorder Style="{StaticResource Card}" Padding="14,12">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Left" Style="{StaticResource Switch}" IsChecked="{Binding Selected}" VerticalAlignment="Top" Margin="0,2,14,0" />
                                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Size}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding Files}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H3}" FontSize="14" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.MutedWrap}" />
                                        <TextBlock Text="{Binding Paths}" Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,4,0,0" ToolTip="{Binding Paths}" />
                                        <TextBlock Text="{Binding Note}" Foreground="{DynamicResource Brush.Warning}" FontSize="11" Margin="0,2,0,0"
                                                   Visibility="{Binding Note, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                </DockPanel>
                            </ctl:ChamferBorder>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <DockPanel Margin="0,4,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Neu analysieren" Command="{Binding RefreshCommand}" />
                        <Button Content="Windows-Speicheroptimierung" Command="{Binding OpenStorageSettingsCommand}" />
                        <Button Style="{StaticResource Button.Primary}" Content="Ausgewählte bereinigen" Command="{Binding CleanCommand}" Margin="0,0,0,8" />
                    </StackPanel>
                    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,8" />
                </DockPanel>
                <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ===================== Desktop Organizer (§14) ===================== -->
    <DataTemplate DataType="{x:Type vm:DesktopOrganizerViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel Margin="0,0,12,24" MaxWidth="1000" HorizontalAlignment="Left">
                <ctl:ChamferBorder Style="{StaticResource StatusBar}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Wrap}" />
                </ctl:ChamferBorder>
                <ctl:ChamferBorder Style="{StaticResource Card.Notice}">
                    <TextBlock Style="{StaticResource Text.Wrap}"
                               Text="Der Organizer ändert nur die Position der Desktopsymbole. Keine Datei wird verschoben, umbenannt oder gelöscht. Vor jeder Änderung wird das Layout gesichert." />
                </ctl:ChamferBorder>

                <WrapPanel>
                    <ctl:ChamferBorder Style="{StaticResource Card}" Width="460" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Anordnung" Style="{StaticResource Text.H2}" />
                            <TextBlock Text="Sortierung" Style="{StaticResource Text.Muted}" Margin="0,0,0,6" />
                            <WrapPanel>
                                <RadioButton Style="{StaticResource Segment}" GroupName="OrgSort" Content="A – Z" IsChecked="{Binding SortAz}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="OrgSort" Content="Z – A" IsChecked="{Binding SortZa}" />
                            </WrapPanel>
                            <TextBlock Text="Bildschirmseite" Style="{StaticResource Text.Muted}" Margin="0,8,0,6" />
                            <WrapPanel>
                                <RadioButton Style="{StaticResource Segment}" GroupName="OrgSide" Content="Links beginnen" IsChecked="{Binding SideLeft}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="OrgSide" Content="Rechts beginnen" IsChecked="{Binding SideRight}" />
                            </WrapPanel>
                            <TextBlock Text="Abstand zwischen Gruppen" Style="{StaticResource Text.Muted}" Margin="0,8,0,6" />
                            <WrapPanel>
                                <RadioButton Style="{StaticResource Segment}" GroupName="OrgGap" Content="Kein" IsChecked="{Binding Gap0}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="OrgGap" Content="1 Spalte" IsChecked="{Binding Gap1}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="OrgGap" Content="2 Spalten" IsChecked="{Binding Gap2}" />
                            </WrapPanel>
                        </StackPanel>
                    </ctl:ChamferBorder>

                    <ctl:ChamferBorder Style="{StaticResource Card}" Width="420" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Desktop" Style="{StaticResource Text.H2}" />
                            <TextBlock Text="{Binding IconCount, StringFormat='{}{0} Symbole erkannt'}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding OtherCount, StringFormat='{}{0} davon System/Andere (werden ebenfalls einsortiert)'}" Style="{StaticResource Text.Muted}" Margin="0,2,0,8" />
                            <TextBlock Text="{Binding BackupCount, StringFormat='{}{0} gesicherte Layouts'}" Style="{StaticResource Text.Muted}" Margin="0,0,0,12" />
                            <Button Style="{StaticResource Button.Primary}" Content="Desktop jetzt organisieren" Command="{Binding OrganizeCommand}" HorizontalAlignment="Left" />
                            <Button Content="Letztes Desktop Layout wiederherstellen" Command="{Binding RestoreLayoutCommand}" HorizontalAlignment="Left" />
                            <Button Content="Vorschau aktualisieren" Command="{Binding PreviewCommand}" HorizontalAlignment="Left" />
                            <TextBlock Style="{StaticResource Text.MutedWrap}" Margin="0,6,0,0"
                                       Text="Hinweis: „Symbole automatisch anordnen“ muss auf dem Desktop deaktiviert sein (Rechtsklick → Ansicht)." />
                        </StackPanel>
                    </ctl:ChamferBorder>
                </WrapPanel>

                <!-- Regeln: Kategorien und Dateitypen -->
                <ctl:ChamferBorder Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Kategorie hinzufügen" Command="{Binding AddCategoryCommand}" />
                                <Button Content="Standard" Command="{Binding ResetRulesCommand}" />
                                <Button Style="{StaticResource Button.Primary}" Content="Regeln speichern" Command="{Binding SaveRulesCommand}" Margin="0,0,0,8" />
                            </StackPanel>
                            <TextBlock Text="Regeln (Reihenfolge = Anordnung auf dem Desktop)" Style="{StaticResource Text.H2}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" Margin="0,0,8,0" />
                                        <TextBox Grid.Column="1" Text="{Binding Extensions, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" Margin="0,0,8,0"
                                                 ToolTip="Dateiendungen, getrennt durch Leerzeichen, z. B. .pdf .docx" />
                                        <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat='{}{0} Symbole'}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Style="{StaticResource Button.Link}" Content="Entfernen"
                                                Command="{Binding DataContext.RemoveCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Text.MutedWrap}" Margin="0,6,0,0"
                                   Text="Eine Kategorie namens „Ordner“ sammelt alle Ordner. Nicht zugeordnete Dateien landen in „Andere“, Systemsymbole (Papierkorb, Dieser PC) ganz am Anfang." />
                    </StackPanel>
                </ctl:ChamferBorder>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ===================== Updates (§31–§33, §64) ===================== -->
    <DataTemplate DataType="{x:Type vm:UpdatesViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel Margin="0,0,12,24">
                <ctl:ChamferBorder Style="{StaticResource StatusBar}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Wrap}" />
                </ctl:ChamferBorder>
                <DockPanel Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Windows Update öffnen" Command="{Binding OpenWindowsUpdateCommand}" />
                        <Button Content="Alles neu prüfen" Command="{Binding RefreshCommand}" Margin="0,0,0,8" />
                    </StackPanel>
                    <TextBlock Text="{Binding LastChecked}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Treiber -->
                <ctl:ChamferBorder Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Suchen" Command="{Binding SearchWindowsUpdatesCommand}" Margin="0" />
                            <TextBlock Text="Treiber-Updates (Windows Update)" Style="{StaticResource Text.H2}" Margin="0" />
                        </DockPanel>
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding IsSearchingWindows, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding WindowsError}" Foreground="{DynamicResource Brush.Problem}" Style="{StaticResource Text.Wrap}" Visibility="{Binding WindowsError, Converter={StaticResource NullToVis}}" />
                        <TextBlock Text="Keine Treiber-Updates angeboten." Style="{StaticResource Text.Muted}"
                                   Visibility="{Binding DriverUpdates.Count, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding DriverUpdates}" ItemTemplate="{DynamicResource UpdateRowTemplate}" />
                        <TextBlock Style="{StaticResource Text.MutedWrap}" Margin="0,8,0,0"
                                   Text="Nur von Microsoft signierte, für die Hardware-ID dieses PCs freigegebene Treiber. Installation erst nach Bestätigung (Windows Hello) und UAC; vorher wird ein Wiederherstellungspunkt angefordert. Rollback: Geräte-Manager → Eigenschaften → Treiber → „Vorheriger Treiber“." />
                    </StackPanel>
                </ctl:ChamferBorder>

                <!-- Windows-Updates -->
                <ctl:ChamferBorder Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Windows-Updates" Style="{StaticResource Text.H2}" />
                        <TextBlock Text="Keine ausstehenden Windows-Updates gefunden." Style="{StaticResource Text.Muted}"
                                   Visibility="{Binding WindowsUpdates.Count, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding WindowsUpdates}" ItemTemplate="{DynamicResource UpdateRowTemplate}" />
                    </StackPanel>
                </ctl:ChamferBorder>

                <!-- Software (winget) -->
                <ctl:ChamferBorder Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Suchen" Command="{Binding SearchSoftwareUpdatesCommand}" />
                                <Button Style="{StaticResource Button.Primary}" Content="Alle aktualisieren" Command="{Binding UpgradeAllSoftwareCommand}" Margin="0" />
                            </StackPanel>
                            <TextBlock Text="Software-Updates (winget)" Style="{StaticResource Text.H2}" Margin="0" />
                        </DockPanel>
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="{Binding IsSearchingSoftware, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding SoftwareError}" Foreground="{DynamicResource Brush.Problem}" Style="{StaticResource Text.Wrap}" Visibility="{Binding SoftwareError, Converter={StaticResource NullToVis}}" />
                        <ItemsControl ItemsSource="{Binding SoftwareUpdates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ctl:ChamferBorder Background="{DynamicResource Brush.SurfaceAlt}" Chamfer="8" Padding="12,8" Margin="0,0,0,6">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Aktualisieren" Margin="10,0,0,0" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.UpgradeSoftwareCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" IsEnabled="{Binding IsInstalling, Converter={StaticResource InvBool}}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource Text.Muted}">
                                                    <Run Text="{Binding Versions, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Id, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Source, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </ctl:ChamferBorder>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ctl:ChamferBorder>

                <!-- Ausgabe -->
                <ctl:ChamferBorder Style="{StaticResource Card}" Visibility="{Binding Output, Converter={StaticResource NullToVis}}">
                    <StackPanel>
                        <TextBlock Text="Ausgabe" Style="{StaticResource Text.H3}" Margin="0,0,0,6" />
                        <ctl:ChamferBorder Background="{DynamicResource Brush.SurfaceAlt}" Chamfer="6" Padding="10" MaxHeight="260">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0"
                                         FontFamily="{StaticResource Font.Mono}" FontSize="12" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </ctl:ChamferBorder>
                    </StackPanel>
                </ctl:ChamferBorder>

                <!-- App-Update (§64) -->
                <ctl:ChamferBorder Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ULTIMATE X" Style="{StaticResource Text.H2}" />
                        <TextBlock Text="{Binding AppUpdateText}" Style="{StaticResource Text.Wrap}" Margin="0,0,0,8" />
                        <ProgressBar Value="{Binding AppUpdateProgress, Mode=OneWay}" Maximum="1" Margin="0,0,0,8" Visibility="{Binding AppUpdateAvailable, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Nach App-Update suchen" Command="{Binding CheckAppCommand}" />
                            <Button Style="{StaticResource Button.Primary}" Content="Update installieren" Command="{Binding InstallAppUpdateCommand}"
                                    Visibility="{Binding AppUpdateAvailable, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.MutedWrap}"
                                   Text="Updates werden nur per HTTPS geladen und erst nach erfolgreicher SHA-256- und Signaturprüfung (gleiches Zertifikat wie die installierte Version) ausgeführt." />
                    </StackPanel>
                </ctl:ChamferBorder>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- Zeile eines Windows-/Treiber-Updates -->
    <DataTemplate x:Key="UpdateRowTemplate" DataType="{x:Type vm:UpdateRow}">
        <ctl:ChamferBorder Background="{DynamicResource Brush.SurfaceAlt}" Chamfer="8" Padding="12,8" Margin="0,0,0,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Installieren" Margin="10,0,0,0" VerticalAlignment="Center"
                        Command="{Binding DataContext.InstallUpdateCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                        CommandParameter="{Binding}" IsEnabled="{Binding IsInstalling, Converter={StaticResource InvBool}}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" ToolTip="{Binding Title}" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Muted}" />
                </StackPanel>
            </DockPanel>
        </ctl:ChamferBorder>
    </DataTemplate>

    <!-- ===================== Prozesse (§77) ===================== -->
    <DataTemplate DataType="{x:Type vm:ProcessesViewModel}">
        <DockPanel Margin="0,0,12,12">
            <StackPanel DockPanel.Dock="Top">
                <DockPanel Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding VerifySignatures}" Content="Signaturen prüfen" Margin="0,0,12,8" />
                        <Button Content="Aktualisieren" Command="{Binding RefreshCommand}" Margin="0,0,0,8" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,12,8" ToolTip="Filtern nach Name, Pfad oder Herausgeber" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,0,8" />
                    </StackPanel>
                </DockPanel>
                <TextBlock Style="{StaticResource Text.MutedWrap}" Margin="0,0,0,8"
                           Text="Nur Anzeige. Ein fehlender Signaturnachweis bedeutet nicht, dass ein Prozess schädlich ist – für eine Bewertung Windows-Sicherheit verwenden." />
            </StackPanel>
            <DataGrid ItemsSource="{Binding Rows}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="24">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><Ellipse Style="{StaticResource StatusDot}" Fill="{Binding State, Converter={StaticResource StateBrush}}" /></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170" />
                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" />
                    <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="70" />
                    <DataGridTextColumn Header="RAM" Binding="{Binding Ram}" Width="90" />
                    <DataGridTextColumn Header="Herausgeber" Binding="{Binding Publisher}" Width="*" />
                    <DataGridTextColumn Header="Signatur" Binding="{Binding Signature}" Width="190" />
                    <DataGridTextColumn Header="Pfad" Binding="{Binding Path}" Width="2*" />
                    <DataGridTemplateColumn Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Button.Link}" Content="Ordner"
                                        Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
