<Window x:Class="UltimateX.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UltimateX.App.ViewModels"
        xmlns:ctl="clr-namespace:UltimateX.App.Controls"
        Title="ULTIMATE X Windows Control"
        Width="1440" Height="900" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/ultimatex.ico"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}"
        TextElement.Foreground="{DynamicResource Brush.Text}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- Kleine Live-Anzeige in der Statusleiste -->
        <Style x:Key="HudLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
            <Setter Property="FontFamily" Value="{StaticResource Font.DisplayCondensed}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HudValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="Margin" Value="0,0,18,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Sidebar (Modern Control Center, §5) ===================== -->
        <Grid Width="252" Visibility="{Binding IsSimpleMode, Converter={StaticResource InvBoolToVis}}">
            <Border Background="{DynamicResource Brush.Sidebar}" />
            <!-- rote Energielinie an der Kante -->
            <Border Width="1" HorizontalAlignment="Right">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{DynamicResource Color.AccentHot}" Offset="0" />
                        <GradientStop Color="{DynamicResource Color.AccentDeep}" Offset="0.35" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,20,18,16">
                    <Image Source="Assets/ultimatex.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource Font.Display}" FontSize="19" FontWeight="Bold">
                            <Run Text="ULTIMATE" /><Run Text=" X" Foreground="{DynamicResource Brush.AccentHot}" />
                        </TextBlock>
                        <TextBlock Text="Windows Control" FontFamily="{StaticResource Font.DisplayCondensed}" FontSize="12"
                                   Foreground="{DynamicResource Brush.TextMuted}" />
                    </StackPanel>
                </StackPanel>

                <!-- Globale Suche (§102) -->
                <Grid DockPanel.Dock="Top" Margin="14,0,14,12">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="30,7,8,7" MaxLength="60">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Text.Icon}" FontSize="13" Margin="10,0,0,0" HorizontalAlignment="Left"
                               Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False" />
                    <TextBlock Text="Suchen (Strg+K) …" Style="{StaticResource Text.Muted}" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding SearchText, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                </Grid>

                <!-- Benutzer / Rechte -->
                <ctl:ChamferBorder DockPanel.Dock="Bottom" Margin="14" Padding="12,10" Chamfer="8" Background="{DynamicResource Brush.Surface}"
                                   BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" AccentBrush="{DynamicResource Brush.Accent}" AccentLength="22">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE77B;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.AccentHot}" Margin="0,0,10,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ElevationText}" Style="{StaticResource Text.Muted}" />
                        </StackPanel>
                    </DockPanel>
                </ctl:ChamferBorder>

                <!-- Navigation -->
                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavItem}">
                            <StackPanel>
                                <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="-12,2,-8,9"
                                        Visibility="{Binding StartsGroup, Converter={StaticResource BoolToVis}}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" FontSize="15" Width="22" />
                                    <TextBlock Text="{Binding Title}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <!-- ===================== Hauptbereich ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Technische Statusleiste: Live-Werte, immer sichtbar -->
            <Border Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="28,7,16,7">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="&#xE770;" Style="{StaticResource Text.Icon}" FontSize="12" Foreground="{DynamicResource Brush.AccentHot}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding OsHeader}" Style="{StaticResource HudLabel}" />
                        <TextBlock Text="{Binding OsHeaderBuild}" Style="{StaticResource HudLabel}" Margin="0,0,16,0" />
                        <TextBlock Text="&#xE7F4;" Style="{StaticResource Text.Icon}" FontSize="12" Foreground="{DynamicResource Brush.AccentHot}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding MachineName}" Style="{StaticResource HudLabel}" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding ClockTime}" Style="{StaticResource HudValue}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding ClockDate}" Style="{StaticResource HudLabel}" Margin="0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="CPU" Style="{StaticResource HudLabel}" />
                        <TextBlock Text="{Binding HudCpu}" Style="{StaticResource HudValue}" />
                        <TextBlock Text="GPU" Style="{StaticResource HudLabel}" />
                        <TextBlock Text="{Binding HudGpu}" Style="{StaticResource HudValue}" />
                        <TextBlock Text="RAM" Style="{StaticResource HudLabel}" />
                        <TextBlock Text="{Binding HudRam}" Style="{StaticResource HudValue}" />
                        <TextBlock Text="CPU °C" Style="{StaticResource HudLabel}" />
                        <TextBlock Text="{Binding HudCpuTemp}" Style="{StaticResource HudValue}" />
                        <TextBlock Text="GPU °C" Style="{StaticResource HudLabel}" />
                        <TextBlock Text="{Binding HudGpuTemp}" Style="{StaticResource HudValue}" />
                        <TextBlock Text="NET" Style="{StaticResource HudLabel}" />
                        <TextBlock Text="{Binding HudNet}" Style="{StaticResource HudValue}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Kopfzeile -->
            <DockPanel Grid.Row="1" Margin="28,18,28,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="90" Height="3" Margin="0,0,14,6"
                                 Visibility="{Binding CurrentPage.IsBusy, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                    <Button Content="‹ Zurück zur Startseite" Command="{Binding BackToSimpleCommand}"
                            Visibility="{Binding ShowBackToSimple, Converter={StaticResource BoolToVis}}" />
                    <Button Command="{Binding CurrentPage.RefreshCommand}" ToolTip="Aktualisieren (F5)">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Text.Icon}" FontSize="14" />
                    </Button>
                    <Button Command="{Binding LockCommand}" ToolTip="Sensible Bereiche sofort sperren" Style="{StaticResource Button.Danger}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" Style="{StaticResource Text.Icon}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="LOCK" FontFamily="{StaticResource Font.Display}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!-- Seitentitel mit rotem Kerbmarker -->
                <DockPanel>
                    <Path DockPanel.Dock="Left" Data="M0,0 L6,0 L6,22 L0,30 Z" Fill="{DynamicResource Brush.AccentHot}" Width="6" Height="30"
                          Stretch="Fill" Margin="0,4,14,0" VerticalAlignment="Top" Effect="{StaticResource Glow.Soft}" />
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentPage.Title}" Style="{StaticResource Text.H1}" />
                        <TextBlock Text="{Binding CurrentPage.Subtitle}" Style="{StaticResource Text.Muted}"
                                   Visibility="{Binding CurrentPage.Subtitle, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                </DockPanel>
            </DockPanel>

            <!-- Seiteninhalt: ViewModel → View über implizite DataTemplates (Views/*.xaml).
                 Beim Seitenwechsel kurzer Übergang (180 ms) – Antwort auf die Benutzeraktion. -->
            <ContentControl x:Name="PageHost" Grid.Row="2" Margin="28,0,16,0" Focusable="False"
                            Content="{Binding CurrentPage, NotifyOnTargetUpdated=True}">
                <ContentControl.RenderTransform>
                    <TranslateTransform />
                </ContentControl.RenderTransform>
                <ContentControl.Triggers>
                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="10" To="0" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </ContentControl.Triggers>
            </ContentControl>

            <!-- Toast -->
            <ctl:ChamferBorder Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24" Padding="18,10" Chamfer="8"
                               Background="{DynamicResource Brush.SurfaceRaised}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1"
                               AccentBrush="{DynamicResource Brush.AccentHot}" AccentLength="28" Effect="{StaticResource Glow.Soft}"
                               Visibility="{Binding Toast, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding Toast}" />
            </ctl:ChamferBorder>
        </Grid>
    </Grid>
</Window>
